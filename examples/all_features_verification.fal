workstation "main":
    say "==========================================="
    say "   FAL ALL-IN-ONE SYSTEM VERIFICATION      "
    say "==========================================="

    // 1. Numerical assignment & Arithmetic Test
    tray1 = 100
    tray2 = 25
    add tray2 to tray1        // tray1 = 125
    sub 5 from tray1          // tray1 = 120
    multiply tray1 by 2       // tray1 = 240
    divide tray1 by 4         // tray1 = 60

    say "Test 1 (Arithmetic):"
    say_number tray1

    // 2. Storeroom RAM Persistence Test
    store tray1 into storeroom[0]
    clear tray1
    load storeroom[0] into tray1
    say "Test 2 (Storeroom RAM persistence):"
    say_number tray1

    // 3. String and Char Assignment Test
    tray3 = 'X'
    tray4 = "Test 3 (String & Char Literal): PASS"
    say tray4

    // 4. Inline Conditional Test
    if tray3 == 'X' then tray4 = "Test 4 (Inline Conditional): PASS"
    say tray4

    // 5. Workstation Subroutine Call & Return Test
    call workstation "subroutine_test"
    say "Test 5 (Subroutine Return Value in tray1):"
    say_number tray1

    say "==========================================="
    say "   ALL FAL CORE PILLARS VERIFIED: 100%     "
    say "==========================================="

    call_supervisor exit
end

workstation "subroutine_test":
    tray1 = 777
    return tray1
end
