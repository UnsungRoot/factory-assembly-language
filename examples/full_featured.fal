workstation main
    say "=== Welcome to FAL Language ==="

    // Simplified assignment & Storeroom write
    tray1 = 42
    store tray1 into storeroom[0]

    // Subroutine call stack
    call process_data

    say "Finished successfully!"
end

workstation process_data
    load storeroom[0] into tray2
    say "Data processed from storeroom!"
    return
end
