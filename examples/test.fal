workstation "main":
    say "=== Math and Tray Operation Test ==="

    tray1 = 10
    tray2 = 5
    add tray2 to tray1
    sub 3 from tray1
    multiply tray1 by 2

    // tray1 is now (10 + 5 - 3) * 2 = 24
    compare tray1 with 24
    jump_if_equal to "math_passed"
    jump to "math_failed"
end

workstation "math_passed":
    say "Math validation passed: result is 24!"
    call_supervisor exit
end

workstation "math_failed":
    say "Math validation failed!"
    call_supervisor exit
end


