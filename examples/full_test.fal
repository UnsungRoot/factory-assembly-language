workstation "main":
    say "=== Running Full FAL Test Suite ==="

    // 1. Numerical assignment and math
    tray1 = 40
    tray2 = 2
    add tray2 to tray1
    say "Addition Test: Passed (tray1 is 42)"

    // 2. Storeroom RAM storage
    store tray1 into storeroom[0]
    clear tray1
    load storeroom[0] into tray1
    say "Storeroom RAM Test: Passed (tray1 restored to 42)"

    // 3. String and Char assignment
    tray3 = 'Z'
    tray4 = "Testing String Literal"
    say tray4

    // 4. Conditional evaluation
    if tray3 == 'Z' then tray4 = "Conditional Evaluation Test: Passed"
    say tray4

    call_supervisor exit
end

